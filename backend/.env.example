# ==== SEGURIDAD (ejecucion real, FASES 0-2) ====
# El bot NUNCA mueve dinero sin: LIVE_TRADING_ENABLED=true, keys con permiso
# TRADING (sin retiro), red aprobada a mano y direccion de deposito del usuario.
# Arranca siempre en DRY-RUN. Para ir a live solo tras el test 1:1 (Fase 1).

# API: la arranca en modo dev (sin clave si esta vacio). Con clave, TODA
# rutas de mutacion exige header `x-api-key` (ejecutar, kill, start/stop...).
# Generar con: openssl rand -hex 24
ARBITRAGEX_API_KEY=
# Host/red de escucha. Loopback por defecto (no expone la API a la web).
HOST=127.0.0.1
# Origenes CORS permitidos para el navegador, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LIVE_TRADING_ENABLED=false

# Limites duros (por trade / por dia / concurrentes / profit minimo %)
MAX_TRADE_SIZE=50
MAX_DAILY_LOSS=10
MAX_CONCURRENT_TRADES=1
MIN_NET_PROFIT_PCT=2
LIVE_TIMEOUT_MIN=30

# Retiros: FALSE por defecto (nunca sacar dinero del exchange sin activarlo).
ALLOW_WITHDRAWALS=false

# Redes aprobadas a mano DESPUES del test real 1:1.
# Formato: "ASSET>EXCHANGE_ORIGEN>EXCHANGE_DESTINO>RED" separadas por coma.
# Todo lo que no este explicitamente aqui queda BLOQUEADO (fallo seguro).
APPROVED_NETWORKS=

# Direcciones de deposito DEL USUARIO en el exchange de venta (verificadas por el).
# Formato: "ASSET>EXCHANGE>RED>DIRECCION[>TAG]" separadas por coma.
# Sin esto, el bot rechaza ejecutar aunque el resto este OK (no retira a ciegas).
DEPOSIT_ADDRESSES=

# Permisos minimos por exchange: trading (sin retiro) + whitelist de IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Algunos exchanges requieren password adicional (kraken, okx, coinbase).
KRAKEN_API_PASSWORD=
OKX_API_PASSWORD=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=